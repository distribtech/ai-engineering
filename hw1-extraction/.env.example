# Скопіюйте у .env і змініть за потреби. Файл .env у git не потрапляє.

# Адреса локальної Ollama. Якщо не задано, береться OLLAMA_HOST, інакше http://127.0.0.1:11434
# OLLAMA_URL=http://127.0.0.1:11434

# Модель за замовчуванням: для вилучення JSON і переказу у вижимці
# OLLAMA_MODEL=qwen3:8b

# Інші моделі для порівняння (вибір у вкладці JSON), через кому. Потрібно `ollama pull <модель>`.
# gemma4:31b (~20 GB) потребує відеокарти з ~24+ GB пам'яті.
# OLLAMA_MODELS=qwen3:8b,gemma4:31b

# Провайдерські моделі через OpenRouter (https://openrouter.ai/keys). Без ключа вони пропускаються.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODELS=deepseek/deepseek-v4.1-flash,anthropic/claude-haiku-5.5,openai/gpt-6-luna
